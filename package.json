{
  "name": "zusantara-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/zusantara",
    "packages/create-zusantara"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w zusantara -w create-zusantara",
    "typecheck": "npm run typecheck -w zusantara -w create-zusantara",
    "test": "npm test -w zusantara -w create-zusantara && node --test scripts/release-approve.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "ai-smoke": "node scripts/ai-smoke.mjs",
    "release:approve": "node scripts/release-approve.mjs",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:serve": "node scripts/docs-serve.mjs"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "devDependencies": {
    "marked": "^18.0.14"
  }
}
